# 키 이름만 둔다 — 값은 GitHub Actions 변수에 (Docs/16-tech-architecture.md §8). 모두 HTML에 실리는 공개값이다
SITE_URL=
BASE_PATH=/
PUBLIC_NOINDEX=
PUBLIC_GA4_ID=
# 오픈일 YYYY-MM-DD — 개인정보처리방침 시행일 (D-053). 비면 공개 빌드가 멈춘다
PUBLIC_OPEN_DATE=
# 데모 신청 페이지 주소 — 현재 운영 사이트와 같은 주소(토큰 포함, D-023). 값은 site/.env · 저장소 변수에만, 문서·저장소에 쓰지 않는다
PUBLIC_DEMO_URL=
PUBLIC_GSC_VERIFICATION=
PUBLIC_NAVER_VERIFICATION=
PUBLIC_BING_VERIFICATION=
