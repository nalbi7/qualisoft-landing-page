---
// 첫 방문 언어 배너 — 한국어 주소에 외국어 브라우저로 왔을 때 헤더 아래 띠로 「이 페이지를 ○○로 보기」 (D-003 · IA §9 「첫 방문 언어 배너」).
// 자동으로 옮기지 않는다. 어느 언어를 보일지는 site.ts 가 navigator.languages 로 고르고, 고르거나 닫으면 기억해 다시 띄우지 않는다.
// 글은 그 언어로 쓴다 — 켠 언어마다 한 줄씩 숨겨 두고 하나만 보인다. 스크립트가 없으면 배너도 없다
import { useT } from '../i18n';
import { DEFAULT_LOCALE, LOCALES } from '../config/locales.mjs';
import { lurl, pagePath } from '../config/routes';
const page = pagePath(Astro.url.pathname);
const others = LOCALES.filter((l) => l.code !== DEFAULT_LOCALE);
---
<div class="langbar" id="langbar" hidden>
  {others.map((l) => {
    const t = useT(l.code);
    return (
      <div class="wrap langbar__in" data-for={l.code} lang={l.lang} hidden>
        <p>{t('lang.banner.text')}</p>
        <a class="btn btn-secondary btn-sm" href={lurl(page, l.code)} hreflang={l.hreflang} data-lang-choice={l.code}>{t('lang.banner.go')}</a>
        <button class="icon-btn" type="button" data-lang-close aria-label={t('lang.banner.close')}>✕</button>
      </div>
    );
  })}
</div>
