---
// 홈 화면 1 — 히어로 (11-screen-spec 4-2, 시안 home-2an.html 5차). 훅(D-017) · v7 예시 화면(D-018) · 첫 방문 등장(D-020 ④)
// 훅의 다섯 상태는 장면 버튼의 data-* 에 실려 있고 home.ts 가 바꿔 끼운다. 훅은 장식이라 화면 낭독에서 숨긴다 — 같은 이름을 장면 버튼이 준다
import { getCollection } from 'astro:content';
import DemoButton from '../DemoButton.astro';
import KakaoButton from '../KakaoButton.astro';
import windowHtml from '../journey-window.html?raw';
import { useT, tx } from '../../i18n';
import { url, lurl, ROUTES, type SolutionSlug } from '../../config/routes';
const loc = Astro.currentLocale;
const t = useT(loc);
const scenes = (await getCollection('solutions')).filter((s) => s.data.hook).sort((a, b) => a.data.order - b.data.order);
const first = scenes[0];
// 예시 화면의 글자는 {{win.키}} 자리 — 지금 언어 글로 채운다(i18n/<언어>/window.json). 글자는 HTML 로 넣지 않는다
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const win = windowHtml.replace(/^<!--[\s\S]*?-->\n/, '').replaceAll('{BASE}', import.meta.env.BASE_URL)
  .replace(/\{\{(win\.[\w.]+)\}\}/g, (_, k: string) => esc(t(k)))
  // 예시 화면 안의 창 제목은 페이지의 제목 단계가 아니다 — h1 바로 밑에 h4 가 와 단계를 건너뛰었다(검색 · 화면 낭독). 같은 모양의 문단으로 (D-040, home.css .scr__h)
  .replace(/<h4>/g, '<p class="scr__h">').replace(/<\/h4>/g, '</p>');
// 일 · 중 화면은 상담 언어를 데모 버튼 옆에 알린다 (IA §9 · R-11). 한국어 · 영어 상담 확인(H-06 해소, D-053)
const consult = t.has('common.consult') ? t('common.consult') : '';
---
<section class="hero2" aria-labelledby="hero-h" data-parity="hero">
  <div class="wrap">
    <p class="ms-mark rv" style="--i:0"><span class="ms-logo"><img class="ms-logo__l" src={url('/assets/ms/microsoft-logo.svg')} alt="Microsoft" width="113" height="24"><img class="ms-logo__d" src={url('/assets/ms/microsoft-logo-white.svg')} alt="Microsoft" aria-hidden="true" width="113" height="24"></span><span class="ms-mark__p">{t('home.hero.partner')}</span></p>
    <div class="hook rv" id="hook" aria-hidden="true" style={`--i:1; --hc:${first.data.color}`} data-parity="hook">
      <div class="hook__name"><span class="swap"><img class="hook__ic" id="hook-ic" src={url(first.data.icon)} alt={first.data.name} width="48" height="48"><span class="hook__nm" id="hook-name" translate="no">{first.data.name}</span></span></div>
      <div class="hook__line"><span class="swap" id="hook-line">{(first.data.hook ? tx(first.data.hook, loc) : "")}</span></div>
    </div>
    <!-- 제목 한 줄 — 옛 랜딩 「기업의 핵심 프로세스 … CRM은 핵심 솔루션」의 의도를 잇는다. 강조 없이 (BD-019 · BD-021) -->
    <h1 id="hero-h" class="hero__h rv" style="--i:2" data-parity="hero-h1">{t('home.hero.title')}</h1>
    <div class="hero__acts rv" style="--i:3" data-parity="hero-acts">
      <DemoButton />
      <KakaoButton />
    </div>
    {consult && <p class="hero__consult rv" style="--i:3">{consult}</p>}
    <div class="hero2__vis journey rv" style="--i:4" id="loop" role="group" aria-label={t('home.journey.group')} data-parity="journey">
      <Fragment set:html={win} />
      <div class="jctl">
        <button class="icon-btn" id="loop-btn" type="button" aria-label={t('home.journey.pause')} data-label-pause={t('home.journey.pause')} data-label-play={t('home.journey.play')}>❚❚</button>
        <div class="steps" role="group" aria-label={t('home.journey.choose')}>
          <span class="steps__ind" aria-hidden="true"></span>
          {scenes.map((s, i) => (
            <button type="button" aria-current={i === 0 ? 'true' : undefined} data-go={i} style={`--sc: ${s.data.color}`}
              data-name={s.data.name} data-line={(s.data.hook ? tx(s.data.hook, loc) : "")} data-color={s.data.color} data-icon={url(s.data.icon)}
              data-href={lurl(ROUTES.solution(s.id as SolutionSlug), loc)}><b><img src={url(s.data.icon)} alt={s.data.name} width="16" height="16">{String(i + 1).padStart(2, '0')}</b><span>{s.data.step}</span></button>
          ))}
        </div>
      </div>
      <a class="hook-more" id="hook-more" href={lurl(ROUTES.solution(first.id as SolutionSlug), loc)} aria-label={`${first.data.name} — ${t('home.journey.more')}`}>{t('home.journey.more')} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
