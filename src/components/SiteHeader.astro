---
// 머리글 — Docs/14-information-architecture.md §5 「헤더」, 시안 home-2an.html. 1080px 이하는 메뉴 버튼이 시트를 연다.
// 「솔루션」 글자는 첫 솔루션 상세로, 화살표는 여섯 솔루션의 세로 목록(아이콘 + 이름)을 연다 (BD-024)
import { getCollection } from 'astro:content';
import DemoButton from './DemoButton.astro';
import NewWindow from './NewWindow.astro';
import { useT } from '../i18n';
import { url, lurl, ROUTES, HAS_CASES, type SolutionSlug } from '../config/routes';
import { LINKS } from '../config/site';
import { LOCALES } from '../config/locales.mjs';
import { pagePath } from '../config/routes';
const loc = Astro.currentLocale;
const t = useT(loc);
const sols = (await getCollection('solutions')).sort((a, b) => a.data.order - b.data.order);
// 언어 버튼 앞의 지구본 — 언어 고르기인 줄 바로 알게 (BD-052). 꺾쇠와 달리 열려도 돌지 않는다(layout.css .globe)
const globe = '<svg class="globe" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9M12 3c-2.5 2.6-3.8 5.6-3.8 9s1.3 6.4 3.8 9"/></svg>';
const chev = '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
const multiLang = LOCALES.length > 1;
// 언어 메뉴 — 같은 페이지의 다른 언어판으로 (IA §5 「언어 메뉴」 · §9). 고르면 그 선택을 기억해 배너를 다시 띄우지 않는다(site.ts)
const page = pagePath(Astro.url.pathname);
const cur = LOCALES.find((l) => l.code === loc) ?? LOCALES[0];
---
<header class="nav" data-parity="header">
  <div class="wrap nav__in">
    <a class="logo" href={lurl(ROUTES.home, loc)}><img src={url('/assets/brand/ver2-logo-dynamics365.png')} alt={t('nav.home')} width="165" height="50"></a>
    <ul class="nav__links">
      <li class="dd"><a href={lurl(ROUTES.solution(sols[0].id as SolutionSlug), loc)}>{t('nav.solutions')}</a><button class="chev" id="dd-btn" type="button" aria-expanded="false" aria-controls="dd-menu" aria-label={t('nav.solutions_menu')} set:html={chev} />
        <div class="dd__menu" id="dd-menu">
          {sols.map((s) => (
            <a class="dd__item" href={lurl(ROUTES.solution(s.id as SolutionSlug), loc)}><span class={s.data.art === 'cop' ? 'pm-box pm-box--cop' : 'pm-box'} style={`--c:${s.data.art === 'cop' ? '' : s.data.color}`}><img src={url(s.data.icon)} alt="" width="24" height="24"></span><b translate="no">{s.data.name}</b></a>
          ))}
        </div>
      </li>
      {HAS_CASES && <li><a href={lurl(ROUTES.customers, loc)}>{t('nav.customers')}</a></li>}
      {/* Blog · YouTube — 바깥 채널이라 새 창, 새 창 표시를 붙인다 (BD-053) */}
      <li><a href={LINKS.blog} target="_blank" rel="noopener">{t('nav.blog')} <NewWindow /></a></li>
      <li><a href={LINKS.youtube} target="_blank" rel="noopener">{t('nav.youtube')} <NewWindow /></a></li>
    </ul>
    <div class="nav__end">
      {/* 다크 · 라이트 — 한 번 다크로 바뀐 뒤에야 나타난다(scripts/ambient-dark.ts 가 hidden 을 푼다). 누를 때마다 서서히 바뀐다 (D-034) */}
      <button class="theme-btn" id="theme-btn" type="button" hidden aria-label={t('nav.theme_dark')} data-label-dark={t('nav.theme_dark')} data-label-light={t('nav.theme_light')}>
        <svg class="theme-btn__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        <svg class="theme-btn__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      </button>
      {multiLang && (
        <div class="lang">
          <button class="lang-btn" id="lang-btn" type="button" aria-expanded="false" aria-controls="lang-menu" aria-label={`${t('nav.lang')} — ${cur.label}`}><Fragment set:html={globe} />{cur.short} <Fragment set:html={chev} /></button>
          <ul class="lang__menu" id="lang-menu">
            {LOCALES.map((l) => <li><a href={lurl(page, l.code)} hreflang={l.hreflang} lang={l.lang} data-lang-choice={l.code} aria-current={l.code === cur.code ? 'true' : undefined}><span>{l.label}</span></a></li>)}
          </ul>
        </div>
      )}
      <DemoButton small />
      <button class="menu-btn" id="mnav-btn" type="button" aria-expanded="false" aria-controls="mnav" aria-label={t('nav.menu')}><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
    </div>
  </div>
  <div class="mnav" id="mnav" hidden>
    <div class="wrap">
      {/* 솔루션은 접어 두고 「솔루션」을 눌러 펼친다 — 스크립트 없이 도는 <details> (BD-025) */}
      <details class="mnav__sec">
        <summary class="mnav__sum"><Fragment set:html={chev} />{t('nav.solutions')}</summary>
        <ul>{sols.map((s) => <li><a href={lurl(ROUTES.solution(s.id as SolutionSlug), loc)}><img class="pi" src={url(s.data.icon)} alt="" width="24" height="24">{s.data.name}</a></li>)}</ul>
      </details>
      <ul>
        {HAS_CASES && <li><a href={lurl(ROUTES.customers, loc)}>{t('nav.customers')}</a></li>}
        <li><a href={LINKS.blog} target="_blank" rel="noopener">{t('nav.blog')} <NewWindow /></a></li>
        <li><a href={LINKS.youtube} target="_blank" rel="noopener">{t('nav.youtube')} <NewWindow /></a></li>
      </ul>
      {/* 아래 줄 — 데모 신청(왼쪽, 최대 360px) · 언어 버튼(오른쪽). 언어 버튼은 아래에서 올라오는 목록(시트)을 연다 (BD-026 · BD-052).
          버튼 글자는 어느 언어 화면에서든 「Language」 — 한국어를 못 읽는 방문자도 찾게 */}
      <div class="mnav__foot">
        <DemoButton />
        {multiLang && <button class="lang-btn" id="mlang-btn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="lang-dlg" aria-label={`Language — ${cur.label}`}><Fragment set:html={globe} /><span lang="en">Language</span><span class="lang-btn__cur">{cur.short}</span> <Fragment set:html={chev} /></button>}
      </div>
      {/* 언어 창은 메뉴 안에 둔다 — 창 안을 눌러도 「메뉴 바깥」으로 보지 않아 메뉴가 같이 닫히지 않게 */}
      {multiLang && (
        <dialog class="langdlg" id="lang-dlg" aria-labelledby="lang-dlg-h">
          <span class="langdlg__grip" aria-hidden="true"></span>
          <div class="langdlg__head"><b id="lang-dlg-h"><Fragment set:html={globe} /><span lang="en">Language</span></b></div>
          <ul>{LOCALES.map((l) => <li><a href={lurl(page, l.code)} hreflang={l.hreflang} lang={l.lang} data-lang-choice={l.code} aria-current={l.code === cur.code ? 'true' : undefined}><span>{l.label}</span></a></li>)}</ul>
        </dialog>
      )}
    </div>
  </div>
</header>
