---
// 자주 묻는 질문 항목 — 접힌 채로 질문(h3)만 보이고, 누르면 답이 펼쳐진다 (D-043, 이전 D-040 은 모두 펼침).
// <details> 라 답은 처음부터 HTML 안에 있다 — 검색엔진 · AI 는 접혀 있어도 그대로 읽는다(누를 때 불러오는 글이 아니다). 스크립트 없이 열고 닫힌다.
// 모양은 솔루션 상세 「핵심 기능」의 「+」 줄과 같은 말씨 (faq.css). Faq.astro 가 감싼다
import type { FaqItem } from '../config/faq';
import { useT } from '../i18n';
import '../styles/faq.css';
interface Props { items: FaqItem[] }
const { items } = Astro.props;
const t = useT(Astro.currentLocale);
---
<div class="faq">
  {items.map((i) => {
    const L = i.ordered ? 'ol' : 'ul';
    return (
      <details class="faq__i">
        <summary class="faq__s"><h3 class="faq__q">{i.q}</h3><span class="faq__plus" aria-hidden="true">+</span></summary>
        <div class="faq__a">
          <p>{i.a}</p>
          {i.after && <p>{i.after}</p>}
          {i.list && (
            <L>{i.list.map((l) => (
              <li>{l.href
                ? <a href={l.href} {...(l.ext ? { target: '_blank', rel: 'noopener' } : {})}>{l.text}{l.ext && <span class="sr-only">{t('common.new_window')}</span>}</a>
                : l.text}</li>
            ))}</L>
          )}
          {i.note && <p>{i.note}</p>}
          {i.more && <p><a class="faq__more" href={i.more.href}>{i.more.text} <span aria-hidden="true">→</span></a></p>}
        </div>
      </details>
    );
  })}
</div>
