---
// 솔루션 상세 왼쪽 — 제품 색 판 + 여섯 솔루션 이동 목록, 지나면 상단 선택 바로 전환 (11-screen-spec 5-1 ③, 시안 solution-crm-2an.html sp2__side)
// 판의 큰 글자는 장식이라 화면 낭독에서 숨긴다 — 같은 이름을 h1 이 준다. 낱말이 여럿이면 판 안에 들게 줄인다 (solution.css 끝 보완)
// Copilot 은 색이 그라데이션이라 --c 대신 sp2__panel--cop 로 칠한다
import { getCollection, type CollectionEntry } from 'astro:content';
import { useT } from '../../i18n';
import { url, lurl, ROUTES, type SolutionSlug } from '../../config/routes';
interface Props { sol: CollectionEntry<'solutions'> }
const { sol } = Astro.props;
const loc = Astro.currentLocale;
const t = useT(loc);
const sols = (await getCollection('solutions')).sort((a, b) => a.data.order - b.data.order);
const s = sol.data;
---
<aside class="sp2__side" data-parity="sol-side">
  <div class:list={['sp2__panel', { 'sp2__panel--cop': s.art === 'cop' }]} style={`--c:${s.color}`}>
    <img class="sp2__ic" src={url(s.icon)} alt="" width="72" height="72">
    {s.family && <p class="sp2__fam">{s.family}</p>}
    <p class:list={['sp2__name', { 'sp2__name--long': s.mark.includes(' ') }]} aria-hidden="true">{s.mark}</p>
  </div>
  <nav class="sp2__nav" aria-label={t('nav.solutions')}><ul>
    {sols.map((x) => (
      <li class:list={[{ 'is-current': x.id === sol.id }]}><a href={lurl(ROUTES.solution(x.id as SolutionSlug), loc)} aria-current={x.id === sol.id ? 'page' : undefined}><img class="pi" src={url(x.data.icon)} alt="" width="24" height="24"><span translate="no">{x.data.name}</span><span class="cur" aria-hidden="true">←</span></a></li>
    ))}
  </ul></nav>
</aside>
<nav class="solution-bar" aria-label={t('nav.solutions')} hidden>
  <div class="wrap"><ul>
    {sols.map((x) => (
      <li class:list={[{ 'is-current': x.id === sol.id }]}><a href={lurl(ROUTES.solution(x.id as SolutionSlug), loc)} aria-current={x.id === sol.id ? 'page' : undefined}><img src={url(x.data.icon)} alt="" width="24" height="24"><span translate="no">{x.data.name}</span></a></li>
    ))}
  </ul></div>
</nav>
