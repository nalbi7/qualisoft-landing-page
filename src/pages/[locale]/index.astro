import HomePage from '../../components/pages/HomePage.astro';
import { DEFAULT_LOCALE, LOCALES } from '../../config/locales.mjs';
export function getStaticPaths() {
  return LOCALES.filter((l) => l.code !== DEFAULT_LOCALE).map((l) => ({ params: { locale: l.code } }));
}
